# ====================================================
# .env — Environment Variables for Siemens Dishwasher Scheduler
# Copy this file to .env and fill in the values.
# NEVER commit .env to git!
# ====================================================

# APP_URL: The public URL of the deployed app (no trailing slash).
# Used to construct the OAuth redirect URI.
# Local:      http://localhost:3000
# Production: https://your-app.railway.app  (or Render/Fly/etc.)
APP_URL="http://localhost:3000"

# Home Connect API credentials (optional — can also be set via the app UI).
# Client Secret is stored server-side only and never exposed to the browser.
CLIENT_ID=""
CLIENT_SECRET=""

# PORT: Server port (default: 3000)
PORT=3000

# NODE_ENV: Set to "production" in deployment
NODE_ENV=development
